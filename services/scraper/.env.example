# ── Source site login (your own account) ──────────────────────────────────────
USS_USER=
USS_PASS=
USS_LOGIN_URL=

# ── The Auction project's Supabase (Project settings > API). SERVICE ROLE key: only here, never in the app ──
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── The Auction project's Cloudflare R2 (a NEW bucket in the separate Cloudflare account) ──
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_KEY=
# Public address the app loads photos from, no trailing slash (the Worker or r2.dev address — no company name in it)
R2_PUBLIC_URL=

# ── Scraper identity ──────────────────────────────────────────────────────────
# Unique name for this PC (used to lock targets so two PCs never scrape the same one)
INSTANCE_ID=
LOCK_TIMEOUT_MIN=120

# ── Cost control ──────────────────────────────────────────────────────────────
# Car photos kept per lot (the auction sheet is extra). Fewer photos = less R2 storage and less phone data.
MAX_PHOTOS=5

# ── What to scrape (read straight from here, no database needed). Blank = the default shown ──
# Only cars made in this year or later, and only auction scores at or above SCORE_MIN (S, 6, 5, 4.5, 4 ...)
YEAR_FROM=2022
YEAR_TO=
SCORE_MIN=4
# `node scrape.js bid tuesday` ticks that day's venues, then UNticks these (names from lib/venues.js, comma separated)
SKIP_VENUES=yokohama,rnagoya
# Brands never scraped (the source site's brand codes). Default skips: Isuzu, Hino, Mitsubishi Fuso, UD Trucks; America
# Toyota/Nissan/Honda/Mazda/Subaru, U.S.A. Other, Tesla; and the whole Korea, South-Africa, Thailand, Construction/farm,
# Others, China and Overseas Others groups. Leave blank to use that default; set your own list to replace it.
SKIP_BRAND_CODES=17,18,1A,1B,3K,3L,3M,3N,3T,3Y,3S,B0,C0,H0,I1,I3,J0,J1,J2,J3,J4,J5,JY,U0,X0,X1,X2,X6

# ── Claude API (used by the enrich step: docket matching, translating notes). Blank = AI steps are skipped ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Safety stop: refuse more AI calls once this many tokens were used in one run (blank = no cap)
AI_MAX_TOKENS_PER_RUN=

# ── Optional run filters (blank = every enabled target) ───────────────────────
FILTER_MAKER_CODE=
FILTER_CAR_CODE=
HISTORY_AUCTION_TIMES=12
# After a model's first history run (backfill above), the daily run only looks back this many auction times
HISTORY_DAILY_TIMES=2
